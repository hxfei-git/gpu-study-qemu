# 基于固定 Alpine virt.aarch64.config 的实验增量。
CONFIG_GPU_BUDDY=y
CONFIG_FW_LOADER=y
# 使用独立版本名，避免加载发行版 6.18.57-0-virt 的模块。
CONFIG_LOCALVERSION="-0-gpgpu-virt"
# CONFIG_LOCALVERSION_AUTO is not set
# Alpine 包内绝对签名路径不可复用；在独立输出目录生成签名密钥。
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# 本实验不依赖 BTF；省去调试信息和 pahole，缩短客体原生构建。
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
CONFIG_DEBUG_INFO_NONE=y

# virt 实验只使用 virtio-blk；不构建其他存储设备和 RAID。
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_FABRICS is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_MD is not set
# CONFIG_MTD is not set
# CONFIG_TARGET_CORE is not set

# 客体使用 PL011 串口；GPU 教学 PCI 驱动不依赖显示、输入或多媒体栈。
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set

# 客体不再作为虚拟机宿主，保留 virtio 客体驱动。
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_VHOST_MENU is not set

# 保留 IPv4、UNIX、PACKET 和 virtio-net；实验不使用下列协议或实体网卡。
# CONFIG_ETHERNET is not set
# CONFIG_WAN is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_NETFILTER is not set
# CONFIG_IPV6 is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_DSA is not set
# CONFIG_L2TP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_ISDN is not set
# CONFIG_ATM is not set
# CONFIG_CAN is not set
# CONFIG_NET_SCHED is not set

# 保留 ext4、9p、proc/sysfs/tmpfs/devtmpfs；9p 需要 NETWORK_FILESYSTEMS。
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
CONFIG_NTFS3_FS=m
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_AFS_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_ORANGEFS_FS is not set

# 树外教学驱动使用 gpu_buddy 导出，不按树内调用关系裁剪符号。
# CONFIG_TRIM_UNUSED_KSYMS is not set

# 固定启动、持久构建盘和第一阶段回归依赖，避免裁剪菜单时连带关闭。
CONFIG_BLK_DEV_INITRD=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_PACKET=m
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_ECAM=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_IOMMU_DMA=y
CONFIG_ARM_SMMU_V3=y
CONFIG_EXT4_FS=m
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_9P_FS=m

# 关闭实验不使用的剩余模块；保留已有内置功能及其必要模块依赖。
# 该配置保留 BINFMT_MISC、balloon 和 XFRM 的内核依赖，支持增量续建。
CONFIG_CEPH_LIB=m
