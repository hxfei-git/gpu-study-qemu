+    for (;;) {
+        reply = recv_deferred(ts);
+        if (reply == NULL) {
+            return ERROR_INT(ECONNRESET);
+        }
+        if (reply->hdr.flags.type == VFIO_USER_F_TYPE_COMMAND) {
+            if (ts->tail != NULL) {
+                ts->tail->next = reply;
+            } else {
+                ts->head = reply;
+            }
+            ts->tail = reply;
+            continue;
+        }
+        if (reply->hdr.flags.type != VFIO_USER_F_TYPE_REPLY ||
+            reply->hdr.msg_id != msg_id || reply->nr_fds != 0) {
+            free_deferred(reply);
+            return ERROR_INT(ECONNRESET);
+        }
+        if (hdr != NULL) {
+            *hdr = reply->hdr;
+        }
+        if (reply->hdr.flags.error) {
+            ret = reply->hdr.error_no > 0 ? reply->hdr.error_no : EINVAL;
+            free_deferred(reply);
+            return ERROR_INT(ret);
+        }
+        if (reply->hdr.msg_size - sizeof(reply->hdr) != recv_len) {
+            free_deferred(reply);
+            return ERROR_INT(ECONNRESET);
+        }
+        if (recv_len != 0) {
+            memcpy(recv_data, reply->body, recv_len);
+        }
+        free_deferred(reply);
+        return 0;
+    }
