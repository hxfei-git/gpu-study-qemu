diff --git a/test/py/test_dma_interleave.py b/test/py/test_dma_interleave.py
new file mode 100644
--- /dev/null
+++ b/test/py/test_dma_interleave.py
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: BSD-3-Clause
+# DMA 等待期间交错的 Host 请求必须完整暂存，不能被当成 DMA 回复。
+
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+from libvfio_user import *
+
+for fn in (lib.vfu_sgl_read, lib.vfu_sgl_write):
+    fn.argtypes = (c.c_void_p, c.POINTER(dma_sg_t), c.c_size_t, c.c_void_p)
+    fn.restype = c.c_int
+
+
+def recv_exact(sock, size):
+    data = b''
+    while len(data) < size:
+        chunk = sock.recv(size - len(data))
+        assert chunk
+        data += chunk
+    return data
+
+
+def receive(sock):
+    hdr = struct.unpack('HHIII', recv_exact(sock, 16))
+    return hdr, recv_exact(sock, hdr[2] - 16)
+
+
+def config_request():
+    body = struct.pack('QII', 0, VFU_PCI_DEV_CFG_REGION_IDX, 4)
+    return vfio_user_header(VFIO_USER_REGION_READ, len(body)) + body
+
+
+def respond_dma(sock, error=0):
+    hdr, body = receive(sock)
+    assert hdr[1] in (VFIO_USER_DMA_READ, VFIO_USER_DMA_WRITE)
+    addr, count = struct.unpack('QQ', body[:16])
+    if error:
+        # 错误回复也带 body，验证它不会留在流中污染下一条报文。
+        payload = b'error-body'
+    else:
+        payload = struct.pack('QQ', addr, count)
+        if hdr[1] == VFIO_USER_DMA_READ:
+            payload += b'\x5a' * count
+        else:
+            assert body[16:] == b'\x33' * count
+    flags = VFIO_USER_F_TYPE_REPLY | (0x20 if error else 0)
+    return struct.pack('HHIII', hdr[0], hdr[1], 16 + len(payload),
+                       flags, error) + payload
+
+
+@pytest.fixture
+def session():
+    ctx = prepare_ctx_for_dma(quiesce=None)
+    sock = connect_client(ctx)
+    sock.settimeout(3)
+    body = vfio_user_dma_map(argsz=len(vfio_user_dma_map()),
+        flags=VFIO_USER_F_DMA_REGION_READ | VFIO_USER_F_DMA_REGION_WRITE,
+        offset=0, addr=0x1000, size=4096)
+    msg(ctx, sock, VFIO_USER_DMA_MAP, body)
+    ret, sg = vfu_addr_to_sgl(ctx, 0x1000, 4)
+    assert ret == 1
+    yield ctx, sock, sg
+    sock.close()
+    vfu_destroy_ctx(ctx)
+
+
+def dma_roundtrip(session, peer, write=False):
+    ctx, sock, sg = session
+    data = c.create_string_buffer(b'\x33' * 4, 4)
+    fn = lib.vfu_sgl_write if write else lib.vfu_sgl_read
+    # 客户端线程只操作 socket，所有库调用仍由同一个线程执行。
+    def checked_peer():
+        try:
+            peer(sock)
+        except BaseException:
+            sock.shutdown(socket.SHUT_RDWR)
+            raise
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        future = pool.submit(checked_peer)
+        ret = fn(ctx, sg, 1, data)
+        saved_errno = c.get_errno()
+        future.result(timeout=3)
+    return ret, saved_errno, data.raw
+
+
+@pytest.mark.parametrize('write', [False, True])
+def test_command_before_dma_reply(session, write):
+    ctx, sock, sg = session
+
+    def peer(sock):
+        reply = respond_dma(sock)
+        sock.sendall(config_request() + reply)
+
+    ret, _, data = dma_roundtrip(session, peer, write)
+    assert ret == 0
+    assert data == (b'\x33' if write else b'\x5a') * 4
+    # 客户端没有再发新请求，仍应能从暂存队列得到一条请求。
+    assert vfu_run_ctx(ctx) == 1
+    hdr, body = receive(sock)
+    assert hdr[1] == VFIO_USER_REGION_READ
+    assert hdr[4] == 0 and len(body) == 20
+    assert vfu_run_ctx(ctx) == 0
+    ret, _, _ = dma_roundtrip(session,
+                              lambda s: s.sendall(respond_dma(s)), write)
+    assert ret == 0
+
+
+def test_error_reply_body_consumed(session):
+    ctx, sock, sg = session
+
+    def peer(sock):
+        reply = respond_dma(sock, errno.EFAULT)
+        sock.sendall(config_request() + reply)
+
+    ret, err, _ = dma_roundtrip(session, peer)
+    assert ret == -1 and err == errno.EFAULT
+    assert vfu_run_ctx(ctx) == 1
+    hdr, _ = receive(sock)
+    assert hdr[4] == 0
+    ret, _, _ = dma_roundtrip(session, lambda s: s.sendall(respond_dma(s)))
+    assert ret == 0
+
+
+def test_deferred_map_preserves_fd(session):
+    ctx, sock, sg = session
+    with tempfile.TemporaryFile() as backing:
+        backing.write(b'\x7b' * 4096)
+        backing.flush()
+        body = vfio_user_dma_map(argsz=len(vfio_user_dma_map()),
+            flags=VFIO_USER_F_DMA_REGION_READ | VFIO_USER_F_DMA_REGION_WRITE,
+            offset=0, addr=0x3000, size=4096)
+        request = vfio_user_header(VFIO_USER_DMA_MAP, len(body)) + bytes(body)
+
+        def peer(sock):
+            reply = respond_dma(sock)
+            sock.sendmsg([request], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
+                                      struct.pack('i', backing.fileno()))])
+            sock.sendall(reply)
+
+        ret, _, _ = dma_roundtrip(session, peer)
+        assert ret == 0
+        assert vfu_run_ctx(ctx) == 1
+        hdr, _ = receive(sock)
+        assert hdr[1] == VFIO_USER_DMA_MAP and hdr[4] == 0
+        ret, mapped = vfu_addr_to_sgl(ctx, 0x3000, 4)
+        assert ret == 1
+        iov = iovec_t()
+        assert vfu_sgl_get(ctx, mapped, iov) == 0
+        assert c.string_at(iov.iov_base, 4) == b'\x7b' * 4
+        vfu_sgl_put(ctx, mapped, iov)
+
+
+@pytest.mark.parametrize('partial', [False, True])
+def test_disconnect_discards_deferred_fd(session, partial):
+    ctx, sock, sg = session
+    with tempfile.TemporaryFile() as backing:
+        backing.truncate(4096)
+        before = len(os.listdir('/proc/self/fd'))
+        body = vfio_user_dma_map(argsz=len(vfio_user_dma_map()),
+            flags=VFIO_USER_F_DMA_REGION_READ, offset=0,
+            addr=0x3000, size=4096)
+        request = vfio_user_header(VFIO_USER_DMA_MAP, len(body)) + bytes(body)
+
+        def peer(sock):
+            receive(sock)
+            fragment = request[:8] if partial else request
+            sock.sendmsg([fragment], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
+                                      struct.pack('i', backing.fileno()))])
+            sock.shutdown(socket.SHUT_RDWR)
+
+        ret, err, _ = dma_roundtrip(session, peer)
+        assert ret == -1 and err == errno.ENOTCONN
+        # 服务端 conn_fd 也关闭了，暂存的 FD 不能泄漏。
+        assert len(os.listdir('/proc/self/fd')) <= before
