+/* DMA 等待时完整接收请求，只暂存，不重入设备回调。 */
+static deferred_request_t *
+recv_deferred(tran_sock_t *ts)
+{
+    deferred_request_t *req = calloc(1, sizeof(*req));
+    size_t size;
+
+    if (req == NULL) {
+        return NULL;
+    }
+    req->fds = calloc(VFIO_USER_CLIENT_MAX_MSG_FDS_LIMIT, sizeof(int));
+    if (req->fds == NULL) {
+        free(req);
+        return NULL;
+    }
+    req->nr_fds = VFIO_USER_CLIENT_MAX_MSG_FDS_LIMIT;
+    if (get_msg(&req->hdr, sizeof(req->hdr), req->fds, &req->nr_fds,
+                ts->conn_fd, MSG_WAITALL) < 0) {
+        goto fail;
+    }
+    if (req->hdr.msg_size < sizeof(req->hdr) ||
+        req->hdr.msg_size > SERVER_MAX_MSG_SIZE) {
+        goto fail;
+    }
+    size = req->hdr.msg_size - sizeof(req->hdr);
+    if (size != 0) {
+        req->body = malloc(size);
+        if (req->body == NULL ||
+            recv(ts->conn_fd, req->body, size, MSG_WAITALL) != (ssize_t)size) {
+            goto fail;
+        }
+    }
+    return req;
+
+fail:
+    free_deferred(req);
+    /* 报文不完整后不能继续解释同一字节流。 */
+    errno = ECONNRESET;
+    return NULL;
+}
