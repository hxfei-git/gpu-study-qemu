+
+static void
+free_deferred(deferred_request_t *req)
+{
+    if (req == NULL) {
+        return;
+    }
+    for (size_t i = 0; i < req->nr_fds; i++) {
+        close(req->fds[i]);
+    }
+    free(req->fds);
+    free(req->body);
+    free(req);
+}
+
+static void
+clear_deferred(tran_sock_t *ts)
+{
+    while (ts->head != NULL) {
+        deferred_request_t *req = ts->head;
+        ts->head = req->next;
+        free_deferred(req);
+    }
+    ts->tail = NULL;
+    free_deferred(ts->current);
+    ts->current = NULL;
+}
 
