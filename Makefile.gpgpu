# SPDX-License-Identifier: GPL-2.0-or-later
# GPGPU：配置和构建 QEMU、RV64 CP 固件，运行设备回归与 Linux 全栈验证。
# 用法：make -f Makefile.gpgpu [目标]

SHELL := /bin/bash
.SHELLFLAGS := -e -o pipefail -c
MAKEFLAGS += -rR
.DEFAULT_GOAL := help

SRC_DIR := $(realpath $(dir $(lastword $(MAKEFILE_LIST))))
BUILD_DIR := $(SRC_DIR)/build
GPGPU_BUILD_DIR ?= $(BUILD_DIR)/arm64-qemu
PYTHON ?= python3
NINJA ?= ninja
JOBS ?= $(shell nproc 2>/dev/null || echo 4)
GPGPU_QTEST_LOG := $(BUILD_DIR)/gpgpu-qtest.log

.PHONY: help configure build test-gpgpu-qtest test-gpgpu-stack
help:
	@echo "GPGPU 构建与验证入口"
	@echo "用法：make -f Makefile.gpgpu <目标>"
	@echo ""
	@echo "  configure         配置 aarch64 Host 与 riscv64 CP，不需要客体内核"
	@echo "  build             构建两个 QEMU、两个 QTest 程序和 RV64 CP 固件"
	@echo "  test-gpgpu-qtest  运行设备寄存器与真实 CP 固件回归，核对 TAP"
	@echo "  test-gpgpu-stack  在 Linux 客体中运行 GPUVM 开／关的三个计算示例"
	@echo ""
	@echo "  JOBS=N                    QEMU 并行构建任务数（默认 $(JOBS)）"
	@echo "  GPGPU_BUILD_DIR=路径      QEMU 配置、构建与 QTest 目录"
	@echo "                            （默认 $(GPGPU_BUILD_DIR)）"
	@echo "全栈验证使用 build/arm64-qemu，需要先准备客体内核与开发镜像。"

configure:
	$(PYTHON) "$(SRC_DIR)/software/gpgpu/scripts/gpgpu_linux.py" configure \
		--qemu-dir "$(GPGPU_BUILD_DIR)"

# 首次构建缺少 build.ninja 时，复用独立配置入口。
$(GPGPU_BUILD_DIR)/build.ninja:
	$(MAKE) -f "$(SRC_DIR)/Makefile.gpgpu" configure

build: $(GPGPU_BUILD_DIR)/build.ninja
	$(MAKE) -C "$(SRC_DIR)/software/gpgpu/firmware"
	$(NINJA) -C "$(GPGPU_BUILD_DIR)" -j$(JOBS) \
		qemu-system-aarch64 qemu-system-riscv64 \
		tests/qtest/gpgpu-regs-test tests/qtest/gpgpu-cp-test

# 退出状态、TAP 计划与结果都必须通过，数量由测试程序提供。
test-gpgpu-qtest: build
	{ QTEST_QEMU_BINARY="$(GPGPU_BUILD_DIR)/qemu-system-aarch64" \
		"$(GPGPU_BUILD_DIR)/tests/qtest/gpgpu-regs-test" --tap && \
	  QTEST_QEMU_BINARY="$(GPGPU_BUILD_DIR)/qemu-system-aarch64" \
		QTEST_GPGPU_REMOTE_BINARY="$(GPGPU_BUILD_DIR)/qemu-system-riscv64" \
		QTEST_GPGPU_REMOTE_LOG_DIR="$(BUILD_DIR)/gpgpu-qtest-logs" \
		QTEST_GPGPU_FIRMWARE="$(BUILD_DIR)/gpgpu-firmware/gpgpu-cp.bin" \
		"$(GPGPU_BUILD_DIR)/tests/qtest/gpgpu-cp-test" --tap; } \
		2>&1 | tee "$(GPGPU_QTEST_LOG)"
	@awk '/^1\.\.[0-9]+/ { planned += substr($$0, 4) } \
		/^ok [0-9]+ / { passed++ } \
		/^not ok |# SKIP/ { failed = 1 } \
		END { if (failed || !planned || passed != planned) exit 1; \
		printf "--- GPGPU QTest: %d/%d passed ---\n", passed, planned }' \
		"$(GPGPU_QTEST_LOG)"

# 固定 A57、1 GiB、IOMMU=none；缺少客体环境时在检查阶段退出。
test-gpgpu-stack:
	$(PYTHON) "$(SRC_DIR)/software/gpgpu/scripts/gpgpu_linux.py" stack-test
